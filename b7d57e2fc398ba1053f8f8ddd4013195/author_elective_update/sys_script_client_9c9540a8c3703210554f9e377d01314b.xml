        <name>Can't Select Max Capacity Base</name>
        <order/>
        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading, isTemplate) {
   if (isLoading || newValue === '') {
      return;
   }

   var ga = new GlideAjax("x_1519575_traini_1.BaseUtils");
   ga.addParam("sysparm_name", "validateBaseCapacity");
   ga.addParam("sysparm_base_sys_id", newValue);

   ga.getXMLAnswer(function(answer) {
	if (answer === "true"){
		g_form.setValue("base", "");
		g_form.showErrorBox("base", "This base is currently at max capacity.");
	}
   });
   
}]]></script>
