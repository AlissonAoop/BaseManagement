        <isolate_script>true</isolate_script>
        <messages/>
        <name>City/State Base Limit</name>
        <order/>
        <script><![CDATA[function onSubmit() {
	var city = g_form.getValue("city");
	var state = g_form.getValue("state");

	if(!city || !state){
		return;
	}

	var ga = new GlideAjax("x_1519575_traini_1.BaseUtils");
	ga.addParam("sysparm_name", "validateCityState");
	ga.addParam("sysparm_city", city.toString());
	ga.addParam("sysparm_state", state.toString());

	var answer = ga.getXMLWait();

	if (answer === "true"){
		g_form.addErrorMessage("There is already a base located in this city and state.");
        g_form.setValue("city", "");
        g_form.setValue("state", "");
        
        return false;
	}
}]]></script>
